ARG NODE_VERSION=24.13.0
FROM node:${NODE_VERSION}-slim

# zip: the service packs each installer into a .zip (see src/server.ts).
RUN apt-get update \
    && apt-get install -y --no-install-recommends zip \
    && rm -rf /var/lib/apt/lists/*

# The repo is bind-mounted at /app: run as `node` (UID 1000, usually the host
# user) so the rebuilt dist/executable-linux isn't owned by root.
USER node

WORKDIR /app/apps/executable

# The service, restarted on changes, plus the watcher rebuilding the Linux
# installer template it serves (dist/executable-linux) on installer changes.
CMD ["sh", "-c", "npm run watch:installer & exec npm run serve:watch"]
