BUCKET_NAME=nanithefuck-instaler
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Keycloak whose tokens authenticate POST /executables (see src/auth.ts)
KEYCLOAK_URI=http://keycloak:8080/auth
# Clients (token `azp`) allowed to call it, comma-separated
EXECUTABLE_ALLOWED_CLIENTS=chatbot

# --- Device owner APK signing (build-time; used by docker compose build via
# the `executable` service secrets, not by the running server) ---
# Keystore (.jks) as base64, so it travels as one secret:
#   base64 -w0 lockdown-release.jks
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
# Optional (defaults: alias `lockdown`, key password = keystore password)
# ANDROID_KEY_ALIAS=lockdown
# ANDROID_KEY_PASSWORD=
