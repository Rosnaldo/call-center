{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "#websocket/*": ["../realtime/src/websocket/*"],
      "#properties": ["../iam/src/properties"],
      "#middleware/*": ["../iam/src/middleware/*"],
      "#controllers/*": ["../iam/src/controllers/*"],
      "#crud/*": ["../iam/src/crud/*"],
      "#daos/*": ["../iam/src/daos/*"],
      "#db/*": ["../iam/src/db/*"],
      "#redis/*": ["../iam/src/redis/*"],
      "#schemas/*": ["../iam/src/entities/schemas/*"],
      "#models/*": ["../iam/src/entities/models/*"],
      "#indexes/*": ["../iam/src/entities/indexes/*"],
      "#entities/*": ["../iam/src/entities/*"],
      "#migrations/*": ["../iam/src/migrations/*"],
      "#utils/*": ["../iam/src/utils/*"],
      "#validations/*": ["../iam/src/validations/*"],
      "#exceptions/*": ["../iam/src/exceptions/*"],
      "#routes/*": ["../iam/src/routes/*"],
      "#helpers/*": ["../iam/src/helpers/*"],
      "#keycloak/*": ["../iam/src/keycloak/*"],
      "#const/*": ["../iam/src/const/*"],
      "#apis/*": ["../iam/src/apis/*"],
      "#auth/*": ["../iam/src/auth/*"],
      "#route_bootstrap": ["../iam/src/route_bootstrap"],
      "#mongoose_bootstrap": ["../iam/src/mongoose_bootstrap"],
      "#redis_bootstrap": ["../iam/src/redis_bootstrap"],
      "src/services/users": ["./src/mocks/realtime-users-service.ts"],
      "src/*": ["../iam/src/*"],
      "@/*": ["../web/*"]
    }
  },
  "include": ["tests", "src", "../iam/src/@types"],
  "exclude": ["node_modules"]
}
