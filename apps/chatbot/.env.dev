CHATBOT_PORT=5004
EXECUTABLE_URL=http://executable:5005
IAM_URI=http://iam:5002
KEYCLOAK_URI=http://keycloak:8080/auth
KEYCLOAK_CLIENT_ID=chatbot
# KEYCLOAK_CLIENT_SECRET goes in apps/chatbot/.env (not committed)
# LLM for free-text answers (src/extractor.ts). ANTHROPIC_API_KEY goes in
# apps/chatbot/.env (not committed); without it, free text is off.
CLAUDE_MODEL=claude-haiku-5-5
