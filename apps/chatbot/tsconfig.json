{
    "compilerOptions": {
        "rootDir": "src",
        "outDir": "./build",
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "lib": ["es2020"],
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "build", "src/**/*.test.ts"]
}
