RUNTIME=js

NODE_ENV=prod
PORT=5002

KEYCLOAK_URI=http://keycloak:8080/auth

MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_INITDB_DATABASE=mydatabase

REALTIME_URI=http://realtime:5003

MONGO_URI=mongodb://admin:secret@mongo:27017/mydatabase?authSource=admin&authMechanism=SCRAM-SHA-256
REDIS_URI=redis://redis:6379

CORS_ORIGINS=https://nanithefuck.com,http://nanithefuck.com
